rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function fs(id) { return /databases/$(database)/documents/friendships/$(id); }
    function friends(other) {
      let a = uid() + '_' + other;
      let b = other + '_' + uid();
      return (exists(fs(a)) && get(fs(a)).data.status == 'accepted')
          || (exists(fs(b)) && get(fs(b)).data.status == 'accepted');
    }
    // the admin account (control panel, can message anyone, moderate)
    function isAdmin() { return signedIn() && uid() == 'P1z4pyemPiZqpS65YBTdzI469yO2'; }
    function adminId() { return 'P1z4pyemPiZqpS65YBTdzI469yO2'; }
    // banned accounts can read but not post, chat or change anything
    function active() { return signedIn() && !exists(/databases/$(database)/documents/bans/$(uid())); }
    function postPath(id) { return /databases/$(database)/documents/posts/$(id); }
    function today() { return string(int(math.floor(request.time.toMillis() / 86400000))); }
    function okImage(v) { return v is string && v.size() < 900000 && (v == '' || v.matches('^(https://|data:image/).*')); }

    // Shop prices: must match js/cosmetics.js
    function prices() { return {'fx_aurora': 400, 'fx_snow': 300, 'fx_sakura': 350, 'fx_fireflies': 350, 'fx_stars': 300, 'fx_matrix': 450, 'fx_embers': 400, 'fx_bubbles': 250, 'fx_confetti': 300, 'fx_rain': 250, 'fx_hearts': 300, 'fx_storm': 500, 'fx_meteor': 450, 'fx_leaves': 300, 'fx_pixel': 350, 'fx_glitter': 400, 'fx_lanterns': 450, 'fx_grid': 400, 'fx_fog': 300, 'fx_blood': 500, 'fx_bloodrain': 450, 'fx_eyes': 450, 'fx_static': 400, 'fx_hands': 450, 'fx_claws': 400, 'fx_flicker': 350, 'fx_galaxy': 500, 'buddy_ted': 500, 'buddy_blob': 300, 'buddy_bot': 400, 'buddy_pip': 300, 'buddy_boo': 350, 'buddy_mochi': 400, 'deco_neon': 250, 'deco_halo': 300, 'deco_flame': 400, 'deco_crown': 350, 'deco_orbit': 300, 'deco_catears': 250, 'deco_glitch': 400, 'deco_sparkle': 300, 'plate_ocean': 200, 'plate_sunset': 200, 'plate_galaxy': 350, 'plate_vapor': 300, 'plate_forest': 200, 'plate_lava': 350, 'plate_holo': 450, 'plate_sakura': 250, 'nfx_rainbow': 300, 'nfx_chrome': 350, 'nfx_fire': 400, 'nfx_neon': 300, 'theme_sakura': 300, 'theme_ocean': 300, 'theme_ember': 300, 'theme_emerald': 300, 'theme_synthwave': 450, 'theme_mono': 250, 'theme_aurora': 400}; }
    function profileOk(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 24
        && d.nameLower == d.name.lower()
        && d.get('bio', '').size() <= 300
        && okImage(d.get('avatar', '')) && d.get('avatar', '').size() < 120000;
    }
    // anything you equip must be something you own
    function equipOk(d) {
      let own = d.get('owned', []);
      return (d.get('fx', '') == '' || own.hasAny([d.get('fx', '')]))
        && (d.get('deco', '') == '' || own.hasAny([d.get('deco', '')]))
        && (d.get('plate', '') == '' || own.hasAny([d.get('plate', '')]))
        && (d.get('nfx', '') == '' || own.hasAny([d.get('nfx', '')]))
        && (d.get('theme', '') == '' || own.hasAny([d.get('theme', '')]))
        && (d.get('buddy', '') == '' || own.hasAny([d.get('buddy', '')]));
    }
    // Glow can only change through the daily reward or a purchase at the listed price
    function economyOk(o, n) {
      let oc = o.get('coins', 0); let nc = n.get('coins', 0);
      let oo = o.get('owned', []); let no = n.get('owned', []);
      let ol = o.get('lastClaim', null); let nl = n.get('lastClaim', null);
      return (nc == oc && no == oo && nl == ol)
        || (no == oo && nl == request.time
            && ((ol == null && nc == oc + 500)
             || (ol != null && request.time > ol + duration.value(20, 'h') && nc == oc + 150)))
        || (no == oo && nl == ol && earnOk(o, n, oc, nc))
        || (no == oo && nl == ol && redeemOk(o, n, oc, nc))
        || (no == oo && nl == ol && projEarnOk(o, n, oc, nc))
        || (nl == ol && no.size() == oo.size() + 1 && no.hasAll(oo)
            && n.get('lastBuy', '') in prices() && no.hasAny([n.lastBuy]) && !oo.hasAny([n.lastBuy])
            && nc == oc - prices()[n.lastBuy] && nc >= 0);
    }

    // Collecting Glow from a post: 50 per new paid-out view, 150 per new paid-out comment,
    // checked against the post's counters before and after the same batched write.
    // Redeeming a Glow code: + exactly the code's amount, paired with this account's one-time redemption record
    function codePath(c) { return /databases/$(database)/documents/codes/$(c); }
    function redeemOk(o, n, oc, nc) {
      let c = n.get('lastCode', '');
      return c != '' && c != o.get('lastCode', '')
        && !exists(/databases/$(database)/documents/codes/$(c)/used/$(uid()))
        && existsAfter(/databases/$(database)/documents/codes/$(c)/used/$(uid()))
        && nc == oc + get(codePath(c)).data.amount;
    }
    // Collecting creator Glow: 20 per minute other people played the game, 50 per post that mentioned it,
    // 50 per positive review, checked against the project's paid-out counters before and after the same write.
    function projPath(id) { return /databases/$(database)/documents/projects/$(id); }
    function projEarnOk(o, n, oc, nc) {
      let pid = n.get('lastProj', '');
      let pb = get(projPath(pid)).data;
      let pa = getAfter(projPath(pid)).data;
      return pid != '' && pa.uid == uid()
        && nc == oc + 20 * (pa.get('paidMin', 0) - pb.get('paidMin', 0)) + 50 * (pa.get('paidMent', 0) - pb.get('paidMent', 0)) + 50 * (pa.get('paidRev', 0) - pb.get('paidRev', 0))
        && nc > oc;
    }
    function earnOk(o, n, oc, nc) {
      let pid = n.get('lastEarn', '');
      let pb = get(postPath(pid)).data;
      let pa = getAfter(postPath(pid)).data;
      return pid != '' && pa.uid == uid()
        && nc == oc + 50 * (pa.get('paidViews', 0) - pb.get('paidViews', 0)) + 150 * (pa.get('paidComments', 0) - pb.get('paidComments', 0))
        && nc > oc;
    }

    // Profiles: anyone signed in can read; only you can write yours.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if active() && uid() == userId && profileOk(request.resource.data)
        && request.resource.data.get('coins', 0) == 0 && request.resource.data.get('owned', []).size() == 0
        && !('lastClaim' in request.resource.data) && equipOk(request.resource.data);
      allow update: if signedIn() && uid() == userId && profileOk(request.resource.data)
        && economyOk(resource.data, request.resource.data) && equipOk(request.resource.data);
      // admin: gift Glow to anyone (including themselves)
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'gift'])
        && request.resource.data.coins is int && request.resource.data.coins >= 0 && request.resource.data.coins <= 1000000000;
      // admin: rename anyone
      allow update: if isAdmin() && profileOk(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameLower']);
      allow delete: if isAdmin();
    }

    // Bans and the server's channel list: only the admin writes these
    match /bans/{userId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Glow codes: the admin makes them; anyone can redeem a code once, until it runs out
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 100000000
        && request.resource.data.maxUses is int && request.resource.data.maxUses >= 1 && request.resource.data.uses == 0;
      allow delete: if isAdmin();
      // one more use, paired with this account's redemption record
      allow update: if active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.uses + 1 && request.resource.data.uses <= resource.data.maxUses
        && !exists(/databases/$(database)/documents/codes/$(code)/used/$(uid()))
        && existsAfter(/databases/$(database)/documents/codes/$(code)/used/$(uid()));
      match /used/{who} {
        allow get: if signedIn() && who == uid();
        allow list: if isAdmin();
        allow create: if active() && who == uid()
          && getAfter(codePath(code)).data.uses == get(codePath(code)).data.uses + 1;
      }
    }
    // ---------- Lumen Creators ----------
    function appPath(u) { return /databases/$(database)/documents/creatorApps/$(u); }
    function isCreator() { return signedIn() && exists(appPath(uid())) && get(appPath(uid())).data.status == 'approved'; }
    // applications: you apply (pending); only the admin can approve or reject
    match /creatorApps/{userId} {
      allow get: if signedIn() && (uid() == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if active() && uid() == userId && request.resource.data.status == 'pending'
        && request.resource.data.about is string && request.resource.data.about.size() <= 600
        && request.resource.data.get('links', '').size() <= 400;
      // re-apply after a rejection
      allow update: if active() && uid() == userId && resource.data.status == 'rejected' && request.resource.data.status == 'pending'
        && request.resource.data.about is string && request.resource.data.about.size() <= 600;
      allow update, delete: if isAdmin();
    }
    // projects: creators submit games and sites; the admin reviews, features, hides and deletes
    function projectOk(d) {
      return d.type in ['game', 'site'] && d.title is string && d.title.size() >= 2 && d.title.size() <= 60
        && d.url is string && d.url.size() <= 500 && d.url.matches('^https://.*')
        && d.get('desc', '').size() <= 300 && okImage(d.get('image', '')) && d.get('image', '').size() < 300000;
    }
    function counters() { return ['minutes', 'mentions', 'upReviews', 'paidMin', 'paidMent', 'paidRev', 'lastMention', 'lastReview']; }
    match /projects/{id} {
      function d() { return request.resource.data; }
      function o() { return resource.data; }
      function keys() { return d().diff(o()).affectedKeys(); }
      function live() { return o().status == 'approved' && o().type == 'game'; }
      allow get: if signedIn() && (resource.data.status == 'approved' || resource.data.uid == uid() || isAdmin());
      allow list: if signedIn() && (resource.data.status == 'approved' || resource.data.uid == uid() || isAdmin());
      allow create: if active() && isCreator() && d().uid == uid() && d().status == 'pending'
        && d().get('featured', false) == false && projectOk(d()) && !d().keys().hasAny(counters());
      // a creator's edit goes back into review (counters can't be touched)
      allow update: if active() && isCreator() && o().uid == uid()
        && keys().hasOnly(['type', 'title', 'url', 'desc', 'image', 'status', 'at'])
        && d().status == 'pending' && projectOk(d());
      allow update: if isAdmin() && projectOk(d()) && d().status in ['pending', 'approved', 'rejected'];
      allow delete: if (signedIn() && o().uid == uid()) || isAdmin();
      // someone else played for one more minute (paired with their rate-limited playtime record)
      allow update: if active() && live() && uid() != o().uid && keys().hasOnly(['minutes'])
        && d().minutes == o().get('minutes', 0) + 1
        && getAfter(/databases/$(database)/documents/projects/$(id)/time/$(uid() + '_' + today())).data.m
           == (exists(/databases/$(database)/documents/projects/$(id)/time/$(uid() + '_' + today())) ? get(/databases/$(database)/documents/projects/$(id)/time/$(uid() + '_' + today())).data.m : 0) + 1;
      // a new post by someone else mentioned this game (paired with the mention record)
      allow update: if active() && live() && uid() != o().uid && keys().hasOnly(['mentions', 'lastMention'])
        && d().mentions == o().get('mentions', 0) + 1
        && !exists(/databases/$(database)/documents/projects/$(id)/mentions/$(d().lastMention))
        && existsAfter(/databases/$(database)/documents/projects/$(id)/mentions/$(d().lastMention));
      // a new positive review by someone else (paired with the review)
      allow update: if active() && live() && uid() != o().uid && keys().hasOnly(['upReviews', 'lastReview'])
        && d().upReviews == o().get('upReviews', 0) + 1 && d().lastReview == uid()
        && !exists(/databases/$(database)/documents/projects/$(id)/reviews/$(uid()))
        && getAfter(/databases/$(database)/documents/projects/$(id)/reviews/$(uid())).data.up == true;
      // the creator marks earnings as paid out (the Glow itself is checked in users)
      allow update: if active() && uid() == o().uid && keys().hasOnly(['paidMin', 'paidMent', 'paidRev'])
        && d().get('paidMin', 0) == o().get('minutes', 0) && d().get('paidMent', 0) == o().get('mentions', 0) && d().get('paidRev', 0) == o().get('upReviews', 0);

      // playtime: one record per player per game per day; +1 minute at most every 50 seconds, up to 4 hours a day
      match /time/{rec} {
        allow get: if signedIn() && rec.matches('^' + uid() + '_.*');
        allow create: if active() && rec == uid() + '_' + today() && get(projPath(id)).data.uid != uid()
          && request.resource.data.m == 1 && request.resource.data.at == request.time
          && getAfter(projPath(id)).data.minutes == get(projPath(id)).data.get('minutes', 0) + 1;
        allow update: if active() && rec == uid() + '_' + today()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['m', 'at'])
          && request.resource.data.m == resource.data.m + 1 && request.resource.data.m <= 240
          && request.resource.data.at == request.time && request.time > resource.data.at + duration.value(50, 's')
          && getAfter(projPath(id)).data.minutes == get(projPath(id)).data.get('minutes', 0) + 1;
      }
      // a post that names the game: one per post, written together with the new post
      match /mentions/{postId} {
        allow read: if signedIn();
        allow create: if active() && !exists(postPath(postId)) && getAfter(postPath(postId)).data.uid == uid()
          && get(projPath(id)).data.uid != uid() && request.resource.data.uid == uid()
          && getAfter(projPath(id)).data.mentions == get(projPath(id)).data.get('mentions', 0) + 1;
      }
      // reviews: one per person, never by the creator; thumbs up or down can't be changed later
      match /reviews/{who} {
        allow read: if signedIn();
        allow create: if active() && who == uid() && get(projPath(id)).data.uid != uid() && get(projPath(id)).data.status == 'approved'
          && reviewOk(request.resource.data)
          && (request.resource.data.up == false
              || getAfter(projPath(id)).data.upReviews == get(projPath(id)).data.get('upReviews', 0) + 1);
        allow update: if active() && who == uid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'at']) && reviewOk(request.resource.data);
        allow delete: if isAdmin();
      }
    }
    function reviewOk(d) { return d.uid == uid() && d.up is bool && d.text is string && d.text.size() <= 500 && d.at == request.time; }
    // reviews of Lumen's built-in games
    match /reviews/{key}/list/{who} {
      allow read: if signedIn();
      allow create: if active() && who == uid() && key.matches('^b_[a-z0-9]+$') && reviewOk(request.resource.data);
      allow update: if active() && who == uid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'at']) && reviewOk(request.resource.data);
      allow delete: if isAdmin();
    }
    // play counts for "Most played": +1 per person per game per day, paired with a play record
    function playPath(k) { return /databases/$(database)/documents/plays/$(k); }
    match /plays/{key} {
      allow read: if signedIn();
      allow create: if active() && request.resource.data.count == 1 && request.resource.data.keys().hasOnly(['count', 'd' + today()])
        && request.resource.data.get('d' + today(), 1) == 1
        && existsAfter(/databases/$(database)/documents/plays/$(key)/by/$(uid() + '_' + today()));
      allow update: if active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'd' + today()])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.get('d' + today(), 0) == resource.data.get('d' + today(), 0) + 1
        && !exists(/databases/$(database)/documents/plays/$(key)/by/$(uid() + '_' + today()))
        && existsAfter(/databases/$(database)/documents/plays/$(key)/by/$(uid() + '_' + today()));
      allow delete: if isAdmin();
      match /by/{rec} {
        allow get: if signedIn() && rec.matches('^' + uid() + '_.*');
        allow create: if active() && rec == uid() + '_' + today()
          && getAfter(playPath(key)).data.count == (exists(playPath(key)) ? get(playPath(key)).data.count : 0) + 1;
      }
    }

    match /server/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.data.get('channels', []).size() <= 40 && request.resource.data.get('pinned', []).size() <= 30;
    }

    // "… is typing": rooms are public; a private chat's typing doc only for its two people.
    // You can only set your own entry, to "now" or to nothing.
    match /typing/{key} {
      function okKey() { return key.matches('^r_.{1,32}$') || (key.matches('^d_[^_]+_[^_]+$') && uid() in key.split('_')); }
      allow read: if signedIn() && okKey();
      allow create: if active() && okKey() && request.resource.data.keys().hasOnly([uid()])
        && (request.resource.data[uid()] == request.time || request.resource.data[uid()] == null);
      allow update: if active() && okKey() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([uid()])
        && (request.resource.data[uid()] == request.time || request.resource.data[uid()] == null);
    }

    // lets people see that the admin messaged them (they aren't friends)
    match /inbox/{userId}/from/{sender} {
      allow read: if signedIn() && uid() == userId;
      allow write: if isAdmin() && sender == uid();
    }

    // Online status + what you're doing: only you and your friends can read it.
    match /presence/{userId} {
      allow read: if signedIn() && (uid() == userId || friends(userId));
      allow write: if active() && uid() == userId;
    }

    // Friend requests. ID is the two user IDs sorted and joined with "_".
    match /friendships/{id} {
      allow read: if signedIn() && uid() in resource.data.users;
      allow create: if active()
        && request.resource.data.from == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && uid() in request.resource.data.users
        && request.resource.data.users[0] < request.resource.data.users[1]
        && id == request.resource.data.users[0] + '_' + request.resource.data.users[1];
      // only the person who received the request can accept it
      allow update: if signedIn() && uid() in resource.data.users && uid() != resource.data.from
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && uid() in resource.data.users;
    }

    // Private chats: only the two friends in the chat.
    match /dms/{pair}/messages/{msg} {
      function members() { return pair.split('_'); }
      function other() { return members()[0] == uid() ? members()[1] : members()[0]; }
      allow read: if signedIn() && uid() in members();
      allow create: if active() && uid() in members() && members().size() == 2
        && (friends(other()) || isAdmin() || other() == adminId())
        && request.resource.data.uid == uid()
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && okImage(request.resource.data.get('gif', ''))
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Public rooms.
    match /rooms/{room}/messages/{msg} {
      allow read: if signedIn();
      allow create: if active() && room.size() <= 32
        && request.resource.data.uid == uid()
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && okImage(request.resource.data.get('gif', ''))
        && request.resource.data.at == request.time;
      allow delete: if (signedIn() && resource.data.uid == uid()) || isAdmin();
    }

    // Posts: likes, views and comments.
    match /posts/{post} {
      function d() { return request.resource.data; }
      function o() { return resource.data; }
      function keys() { return d().diff(o()).affectedKeys(); }
      allow read: if signedIn();
      allow create: if active() && d().uid == uid()
        && d().text is string && d().text.size() <= 2000
        && okImage(d().get('image', ''))
        && d().at == request.time
        && d().get('likes', []).size() == 0 && d().get('views', 0) == 0 && d().get('ecomments', 0) == 0
        && d().get('paidViews', 0) == 0 && d().get('paidComments', 0) == 0;
      // like or unlike: add or remove only your own id
      allow update: if active() && keys().hasOnly(['likes']) && d().likes.size() <= 5000
        && ((d().likes.toSet().difference(o().get('likes', []).toSet()) == [uid()].toSet() && o().get('likes', []).toSet().difference(d().likes.toSet()).size() == 0)
         || (o().get('likes', []).toSet().difference(d().likes.toSet()) == [uid()].toSet() && d().likes.toSet().difference(o().get('likes', []).toSet()).size() == 0));
      // a view: +1, paired with a new view record (max 2 per account per post per day, never the author)
      allow update: if active() && uid() != o().uid && keys().hasOnly(['views', 'lastView'])
        && d().views == o().get('views', 0) + 1
        && (d().lastView == uid() + '_' + today() + '_1' || d().lastView == uid() + '_' + today() + '_2')
        && !exists(/databases/$(database)/documents/posts/$(post)/views/$(d().lastView))
        && existsAfter(/databases/$(database)/documents/posts/$(post)/views/$(d().lastView));
      // a comment from someone else: +1, paired with the new comment
      allow update: if active() && uid() != o().uid && keys().hasOnly(['ecomments', 'lastComment'])
        && d().ecomments == o().get('ecomments', 0) + 1
        && !exists(/databases/$(database)/documents/posts/$(post)/comments/$(d().lastComment))
        && getAfter(/databases/$(database)/documents/posts/$(post)/comments/$(d().lastComment)).data.uid == uid();
      // the author marks views and comments as paid out (the Glow itself is checked in users)
      allow update: if active() && uid() == o().uid && keys().hasOnly(['paidViews', 'paidComments'])
        && d().paidViews == o().get('views', 0) && d().paidComments == o().get('ecomments', 0)
        && d().paidViews >= o().get('paidViews', 0) && d().paidComments >= o().get('paidComments', 0);
      allow delete: if (signedIn() && o().uid == uid()) || isAdmin();

      match /views/{v} {
        allow get: if signedIn() && v.matches('^' + uid() + '_.*');
        allow create: if active() && v.matches('^' + uid() + '_' + today() + '_[12]$')
          && request.resource.data.uid == uid()
          && get(postPath(post)).data.uid != uid()
          && getAfter(postPath(post)).data.views == get(postPath(post)).data.get('views', 0) + 1;
      }

      match /comments/{c} {
        allow read: if signedIn();
        allow create: if active() && request.resource.data.uid == uid()
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && okImage(request.resource.data.get('gif', ''))
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && (resource.data.uid == uid() || get(postPath(post)).data.uid == uid()) || isAdmin();
      }
    }
  }
}
