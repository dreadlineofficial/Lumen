rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function fs(id) { return /databases/$(database)/documents/friendships/$(id); }
    function friends(other) {
      let a = uid() + '_' + other;
      let b = other + '_' + uid();
      return (exists(fs(a)) && get(fs(a)).data.status == 'accepted')
          || (exists(fs(b)) && get(fs(b)).data.status == 'accepted');
    }
    // the admin account (control panel, can message anyone, moderate)
    function isOwner() { return signedIn() && uid() == 'P1z4pyemPiZqpS65YBTdzI469yO2'; }
    // Lumen premium: subs/{uid} holds an end date for each plan (written only by redeeming a premium code)
    function subPath(u) { return /databases/$(database)/documents/subs/$(u); }
    function subOf(u) { return exists(subPath(u)) ? get(subPath(u)).data : {}; }
    function liveTs(s, k) { return s.get(k, null) != null && s[k] > request.time; }
    function isLiteU(u) { let s = subOf(u); return liveTs(s, 'lite') || liveTs(s, 'pro') || liveTs(s, 'ultimate'); }
    function isLite() { return signedIn() && isLiteU(uid()); }
    function isUpgrade() { return signedIn() && liveTs(subOf(uid()), 'upgrade'); }
    function isPro() { return signedIn() && (liveTs(subOf(uid()), 'pro') || liveTs(subOf(uid()), 'ultimate')); }
    function isUlt() { return signedIn() && liveTs(subOf(uid()), 'ultimate'); }
    // Pro members, and Ultimate members with a current admin renewal, share the control panel (the owner keeps the economy)
    function isStaff() { let s = subOf(uid()); return liveTs(s, 'pro') || (liveTs(s, 'ultimate') && liveTs(s, 'ultAdmin')); }
    function isAdmin() { return isOwner() || (signedIn() && isStaff()); }
    // how many 900 KB pieces a creator item or profile picture may use: 4 MB free, 10 MB Lite, 15 MB Upgrade
    function maxParts() { return isUpgrade() ? 24 : isLite() ? 16 : 8; }
    // a 10/15 MB GIF or photo (avatar, banner, chat picture) stored in pieces in media/{id}
    function mediaRef(v) { return v is string && v.matches('^media:[A-Za-z0-9]{16,30}$'); }
    function ownMedia(v) { return getAfter(/databases/$(database)/documents/media/$(v.split(':')[1])).data.uid == uid(); }
    function adminId() { return 'P1z4pyemPiZqpS65YBTdzI469yO2'; }
    // banned accounts can read but not post, chat or change anything
    function active() { return signedIn() && !exists(/databases/$(database)/documents/bans/$(uid())); }
    function postPath(id) { return /databases/$(database)/documents/posts/$(id); }
    function today() { return string(int(math.floor(request.time.toMillis() / 86400000))); }
    function okImage(v) { return v is string && v.size() < 900000 && (v == '' || v.matches('^(https://|data:image/).*')); }

    // Shop prices: must match js/cosmetics.js (and BUILTINS in js/hub.js for paid built-in games)
    function prices() { return {'nfx_ice': 300, 'nfx_toxic': 300, 'nfx_glitch': 400, 'nfx_wave': 350, 'nfx_sparkle': 350, 'nfx_shadow': 250, 'nfx_retro': 350, 'nfx_candy': 300, 'fx_bokeh': 350, 'fx_butterflies': 400, 'fx_sunrays': 350, 'fx_ripples': 300, 'fx_sparks': 400, 'fx_aurora': 400, 'fx_snow': 300, 'fx_sakura': 350, 'fx_fireflies': 350, 'fx_stars': 300, 'fx_matrix': 450, 'fx_embers': 400, 'fx_bubbles': 250, 'fx_confetti': 300, 'fx_rain': 250, 'fx_hearts': 300, 'fx_storm': 500, 'fx_meteor': 450, 'fx_leaves': 300, 'fx_pixel': 350, 'fx_glitter': 400, 'fx_lanterns': 450, 'fx_grid': 400, 'fx_fog': 300, 'fx_blood': 500, 'fx_bloodrain': 450, 'fx_eyes': 450, 'fx_static': 400, 'fx_hands': 450, 'fx_claws': 400, 'fx_flicker': 350, 'fx_galaxy': 500, 'buddy_ted': 500, 'buddy_blob': 300, 'buddy_bot': 400, 'buddy_pip': 300, 'buddy_boo': 350, 'buddy_mochi': 400, 'deco_neon': 250, 'deco_halo': 300, 'deco_flame': 400, 'deco_crown': 350, 'deco_orbit': 300, 'deco_catears': 250, 'deco_glitch': 400, 'deco_sparkle': 300, 'plate_ocean': 200, 'plate_sunset': 200, 'plate_galaxy': 350, 'plate_vapor': 300, 'plate_forest': 200, 'plate_lava': 350, 'plate_holo': 450, 'plate_sakura': 250, 'nfx_rainbow': 300, 'nfx_chrome': 350, 'nfx_fire': 400, 'nfx_neon': 300, 'theme_sakura': 300, 'theme_ocean': 300, 'theme_ember': 300, 'theme_emerald': 300, 'theme_synthwave': 450, 'theme_mono': 250, 'theme_aurora': 400, 'b_fixinggood': 800}; }
    function profileOk(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 24
        && d.nameLower == d.name.lower()
        && d.get('bio', '').size() <= 300
        && ((okImage(d.get('avatar', '')) && d.get('avatar', '').size() < 120000) || (mediaRef(d.get('avatar', '')) && isLite()))
        && (!mediaRef(d.get('banner', '')) || isLite())
        && (!('buddyX' in d) || (d.buddyX is int && d.buddyX >= -1 && d.buddyX <= 100))
        && (!('mutedPosts' in d) || (d.mutedPosts is list && d.mutedPosts.size() <= 300));
    }
    // the tier tag on your profile must match your plan; premium-only profile options need a plan
    function tierOk(d) {
      let s = existsAfter(subPath(uid())) ? getAfter(subPath(uid())).data : {};
      return (d.get('tier', '') == '' || (d.tier in ['lite', 'pro', 'ultimate'] && s.get(d.tier, null) == d.get('tierUntil', 0)))
        && (d.get('up', false) == false || s.get('upgrade', null) == d.get('upUntil', 0))
        && (!(d.get('nameFont', '') in ['script', 'pixel', 'gothic', 'wide']) || isLite())
        && (d.get('cardBorder', '') in ['', 'none'] || isLite())
        && (!(d.get('cardStyle', '') in ['aurora', 'holo', 'midnight']) || isLite());
    }
    // premium-only cosmetics: worn for free while the plan is active, never sold
    function liteItems() { return ['nfx_gold', 'fx_golddust', 'deco_laurel']; }
    function upItems() { return ['fx_prism', 'deco_prism', 'plate_prism', 'nfx_prism']; }
    function proItems() { return ['fx_circuit', 'deco_proorbit', 'plate_pro', 'nfx_pro']; }
    function ultItems() { return ['fx_nebula', 'deco_crownhalo', 'plate_ult', 'nfx_ult']; }
    function wearOk(own, v) {
      return v == '' || own.hasAny([v]) || (v in liteItems() && isLite()) || (v in upItems() && isUpgrade())
        || (v in proItems() && isPro()) || (v in ultItems() && isUlt());
    }
    // stickers on your profile bar (beta, Lite): up to 3 of your own sticker items, each placed and sized
    function stkOk(s, own) {
      return s is map && s.keys().hasOnly(['id', 'x', 'y', 's', 'r']) && s.id is string && own.hasAny([s.id])
        && s.x is int && s.x >= 0 && s.x <= 100 && s.y is int && s.y >= 0 && s.y <= 100
        && s.s is int && s.s >= 50 && s.s <= 200 && s.r is int && s.r >= -45 && s.r <= 45;
    }
    function stickersOk(o, d) {
      let st = d.get('stickers', []);
      let own = d.get('owned', []);
      return st == o.get('stickers', []) || (st is list && st.size() <= 3 && (st.size() == 0 || isLite())
        && (st.size() < 1 || stkOk(st[0], own)) && (st.size() < 2 || stkOk(st[1], own)) && (st.size() < 3 || stkOk(st[2], own)));
    }
    // anything you equip must be something you own
    function equipOk(d) {
      let own = d.get('owned', []);
      return wearOk(own, d.get('fx', '')) && wearOk(own, d.get('deco', '')) && wearOk(own, d.get('plate', ''))
        && wearOk(own, d.get('nfx', '')) && wearOk(own, d.get('theme', '')) && wearOk(own, d.get('buddy', ''));
    }
    // a price: the full amount, or 10% off with Lite (prices are multiples of 10)
    function payOk(oc, nc, p) { return nc >= 0 && (nc == oc - p || (isLite() && nc * 10 == oc * 10 - p * 9)); }
    // a payout: the exact amount, or up to 5% more with Lite
    function bonusOk(oc, nc, x) { return nc == oc + x || (isLite() && nc >= oc + x && (nc - oc) * 20 <= x * 21); }
    function bundles() { return {
      'bundle_horror': {'items': ['fx_bloodrain', 'fx_eyes', 'fx_flicker', 'deco_glitch'], 'price': 1200},
      'bundle_cozy': {'items': ['fx_snow', 'fx_lanterns', 'plate_forest', 'theme_ember'], 'price': 900},
      'bundle_neon': {'items': ['fx_grid', 'deco_neon', 'plate_vapor', 'nfx_neon', 'theme_synthwave'], 'price': 1200},
      'bundle_dream': {'items': ['fx_sakura', 'deco_halo', 'plate_sakura', 'theme_sakura'], 'price': 850},
      'bundle_space': {'items': ['fx_galaxy', 'fx_meteor', 'plate_galaxy', 'deco_orbit'], 'price': 1150},
      'bundle_names': {'items': ['nfx_ice', 'nfx_toxic', 'nfx_glitch', 'nfx_sparkle'], 'price': 1000}
    }; }
    function bundleOk(n, oc, nc, no, oo) {
      let id = n.get('lastBuy', '');
      let all = bundles();
      return id in all && no.hasAll(all[id].items)
        && no.toSet().difference(oo.toSet()).difference(all[id].items.toSet()).size() == 0
        && no.size() > oo.size() && payOk(oc, nc, all[id].price);
    }
    // one catalog item at its price (buddies need Lite); the price list is built once
    function catalogBuyOk(n, oc, nc, no, oo) {
      let id = n.get('lastBuy', '');
      let pr = prices();
      return id in pr && no.hasAny([id]) && !oo.hasAny([id])
        && payOk(oc, nc, pr[id]) && (!id.matches('^buddy_.*') || isLite());
    }
    // daily challenges: 100 Glow (+5% with Lite) once per puzzle per day, after it was really played for a while
    function dailyPath(id) { return /databases/$(database)/documents/dailies/$(id); }
    function dailyOk(n, oc, nc) {
      let id = n.get('lastDaily', '');
      return id.matches('^' + uid() + '_' + today() + '_(mines|memory|slide)$')
        && exists(dailyPath(id)) && get(dailyPath(id)).data.done == false && getAfter(dailyPath(id)).data.done == true
        && bonusOk(oc, nc, 100);
    }
    // a premium code with Glow (Lite, Pro, Ultimate): + exactly its Glow, once per code
    function pcodePath(c) { return /databases/$(database)/documents/pcodes/$(c); }
    function premiumGlowOk(o, n, oc, nc) {
      let c = n.get('lastPCode', '');
      return c != '' && c != o.get('lastPCode', '')
        && !exists(/databases/$(database)/documents/pcodes/$(c)/used/$(uid()))
        && existsAfter(/databases/$(database)/documents/pcodes/$(c)/used/$(uid()))
        && get(pcodePath(c)).data.get('glow', 0) > 0 && nc == oc + get(pcodePath(c)).data.glow;
    }
    // Glow can only change through the daily reward or a purchase at the listed price
    function economyOk(o, n) {
      let oc = o.get('coins', 0); let nc = n.get('coins', 0);
      let oo = o.get('owned', []); let no = n.get('owned', []);
      let ol = o.get('lastClaim', null); let nl = n.get('lastClaim', null);
      return (nc == oc && no == oo && nl == ol)
        || (no == oo && nl == request.time
            && ((ol == null && bonusOk(oc, nc, 500))
             || (ol != null && request.time > ol + duration.value(20, 'h') && bonusOk(oc, nc, 150))))
        || (no == oo && nl == ol && premiumGlowOk(o, n, oc, nc))
        || (no == oo && nl == ol && n.get('lastDaily', '') != o.get('lastDaily', '') && dailyOk(n, oc, nc))
        || (nl == ol && no.hasAll(oo) && n.get('lastBuy', '').matches('^bundle_[a-z]+$') && bundleOk(n, oc, nc, no, oo))
        || (nl == ol && no.size() == oo.size() + 1 && no.hasAll(oo) && catalogBuyOk(n, oc, nc, no, oo))
        || (no == oo && nl == ol && earnOk(o, n, oc, nc))
        || (no == oo && nl == ol && redeemOk(o, n, oc, nc))
        || (no == oo && nl == ol && projEarnOk(o, n, oc, nc))
        || (no == oo && nl == ol && itemEarnOk(o, n, oc, nc))
        || (nl == ol && no.size() == oo.size() + 1 && no.hasAll(oo) && creatorBuyOk(n, oc, nc, no, oo))
        || (nl == ol && no.size() == oo.size() + 1 && no.hasAll(oo) && gameBuyOk(n, oc, nc, no, oo))
        || (nl == ol && nc == oc && no.size() == oo.size() + 1 && no.hasAll(oo) && ownItemOk(n, no, oo));

    }

    // Collecting Glow from a post: 10 per new paid-out view, 50 per new paid-out comment,
    // checked against the post's counters before and after the same batched write.
    // Redeeming a Glow code: + exactly the code's amount, paired with this account's one-time redemption record
    function codePath(c) { return /databases/$(database)/documents/codes/$(c); }
    function redeemOk(o, n, oc, nc) {
      let c = n.get('lastCode', '');
      return c != '' && c != o.get('lastCode', '')
        && !exists(/databases/$(database)/documents/codes/$(c)/used/$(uid()))
        && existsAfter(/databases/$(database)/documents/codes/$(c)/used/$(uid()))
        && nc == oc + get(codePath(c)).data.amount;
    }
    // Collecting creator Glow: 10 per minute other people played the game, 50 per post that mentioned it,
    // 50 per positive review, checked against the project's paid-out counters before and after the same write.
    function projPath(id) { return /databases/$(database)/documents/projects/$(id); }
    function projEarnOk(o, n, oc, nc) {
      let pid = n.get('lastProj', '');
      let pb = get(projPath(pid)).data;
      let pa = getAfter(projPath(pid)).data;
      return pid != '' && pa.uid == uid()
        && bonusOk(oc, nc, 10 * (pa.get('paidMin', 0) - pb.get('paidMin', 0)) + 50 * (pa.get('paidMent', 0) - pb.get('paidMent', 0)) + 50 * (pa.get('paidRev', 0) - pb.get('paidRev', 0))
             + (pa.get('paidSold', 0) - pb.get('paidSold', 0)))
        && nc > oc;
    }
    // Creator shop items: buying one costs exactly its price; the creator later collects 90% of each sale
    function itemPath(i) { return /databases/$(database)/documents/shopItems/$(i); }
    function creatorBuyOk(n, oc, nc, no, oo) {
      let id = n.get('lastBuy', '');
      return id.matches('^c_[A-Za-z0-9]{8,24}$') && no.hasAny([id]) && !oo.hasAny([id])
        && get(itemPath(id)).data.status == 'approved' && get(itemPath(id)).data.uid != uid()
        && (get(itemPath(id)).data.type != 'sticker' || isLite())
        && payOk(oc, nc, get(itemPath(id)).data.price)
        && getAfter(itemPath(id)).data.get('sales', 0) == get(itemPath(id)).data.get('sales', 0) + 1;
    }
    // Marketplace: buying a product (or getting a free one) costs exactly its price, paired with its sale counter (owned gets "p_<id>")
    function gameBuyOk(n, oc, nc, no, oo) {
      let id = n.get('lastBuy', '');
      let pid = id.split('_')[1];
      return id.matches('^p_[A-Za-z0-9]{10,40}$') && no.hasAny([id]) && !oo.hasAny([id])
        && get(projPath(pid)).data.status == 'approved' && get(projPath(pid)).data.uid != uid() && get(projPath(pid)).data.type != 'site'
        && payOk(oc, nc, get(projPath(pid)).data.get('price', 0))
        && getAfter(projPath(pid)).data.get('sales', 0) == get(projPath(pid)).data.get('sales', 0) + 1;
    }
    // creators equip their own approved shop items for free
    function ownItemOk(n, no, oo) {
      let id = n.get('lastBuy', '');
      return id.matches('^c_[A-Za-z0-9]{8,24}$') && no.hasAny([id]) && !oo.hasAny([id])
        && get(itemPath(id)).data.uid == uid() && get(itemPath(id)).data.status == 'approved';
    }
    function itemEarnOk(o, n, oc, nc) {
      let id = n.get('lastItem', '');
      let pb = get(itemPath(id)).data;
      let pa = getAfter(itemPath(id)).data;
      return id != '' && pa.uid == uid() && bonusOk(oc, nc, pa.get('paidEarned', 0) - pb.get('paidEarned', 0)) && nc > oc;
    }
    function earnOk(o, n, oc, nc) {
      let pid = n.get('lastEarn', '');
      let pb = get(postPath(pid)).data;
      let pa = getAfter(postPath(pid)).data;
      return pid != '' && pa.uid == uid() && pa.get('flagged', null) == null
        && bonusOk(oc, nc, 10 * (pa.get('paidViews', 0) - pb.get('paidViews', 0)) + 50 * (pa.get('paidComments', 0) - pb.get('paidComments', 0)))
        && nc > oc;
    }

    // Profiles: anyone signed in can read; only you can write yours.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if active() && uid() == userId && profileOk(request.resource.data)
        && request.resource.data.get('coins', 0) == 0 && request.resource.data.get('owned', []).size() == 0
        && !('lastClaim' in request.resource.data) && equipOk(request.resource.data) && !('stickers' in request.resource.data);
      allow update: if signedIn() && uid() == userId && profileOk(request.resource.data)
        && economyOk(resource.data, request.resource.data) && equipOk(request.resource.data) && tierOk(request.resource.data)
        && stickersOk(resource.data, request.resource.data);
      // admin: gift Glow to anyone (including themselves)
      allow update: if isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'gift'])
        && request.resource.data.coins is int && request.resource.data.coins >= 0 && request.resource.data.coins <= 1000000000;
      // admin: rename anyone
      allow update: if isAdmin() && profileOk(request.resource.data) && (userId != adminId() || isOwner())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameLower']);
      allow delete: if isAdmin() && userId != adminId();
    }

    // Bans and the server's channel list: only the admin writes these
    match /bans/{userId} {
      allow read: if signedIn();
      allow write: if isAdmin() && userId != adminId();
    }
    // Glow codes: the admin makes them; anyone can redeem a code once, until it runs out
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if isOwner();
      allow create: if isOwner() && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 100000000
        && request.resource.data.maxUses is int && request.resource.data.maxUses >= 1 && request.resource.data.uses == 0;
      allow delete: if isOwner();
      // one more use, paired with this account's redemption record
      allow update: if active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.uses + 1 && request.resource.data.uses <= resource.data.maxUses
        && !exists(/databases/$(database)/documents/codes/$(code)/used/$(uid()))
        && existsAfter(/databases/$(database)/documents/codes/$(code)/used/$(uid()));
      match /used/{who} {
        allow get: if signedIn() && who == uid();
        allow list: if isAdmin();
        allow create: if active() && who == uid()
          && getAfter(codePath(code)).data.uses == get(codePath(code)).data.uses + 1;
      }
    }
    // ---------- Lumen premium ----------
    // premium codes: the owner makes them; each grants plans for a number of days, once per person, until it runs out
    function plansOk(g) {
      return g.keys().hasOnly(['lite', 'upgrade', 'pro', 'ultimate', 'ultAdmin']) && g.size() >= 1
        && g.values().hasOnly([30, 90, 180, 365, 730, 36500]);
    }
    match /pcodes/{code} {
      allow get: if signedIn();
      allow list, delete: if isOwner();
      allow create: if isOwner() && plansOk(request.resource.data.grants) && request.resource.data.glow in [0, 5000]
        && request.resource.data.maxUses is int && request.resource.data.maxUses >= 1 && request.resource.data.uses == 0;
      allow update: if active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.uses + 1 && request.resource.data.uses <= resource.data.maxUses
        && !exists(/databases/$(database)/documents/pcodes/$(code)/used/$(uid()))
        && existsAfter(/databases/$(database)/documents/pcodes/$(code)/used/$(uid()));
      match /used/{who} {
        allow get: if signedIn() && who == uid();
        allow list: if isOwner();
        allow create: if active() && who == uid()
          && getAfter(pcodePath(code)).data.uses == get(pcodePath(code)).data.uses + 1;
      }
    }
    // your plans: extended only by redeeming a premium code (each plan's end date moves forward by the code's days, ±10 min)
    function planStep(o, n, k, g) {
      let base = (o.get(k, null) != null && o[k] > request.time) ? o[k] : request.time;
      return (k in g)
        ? (n.get(k, null) is timestamp && n[k] >= base + duration.value(g[k], 'd') - duration.value(10, 'm') && n[k] <= base + duration.value(g[k], 'd') + duration.value(10, 'm'))
        : n.get(k, null) == o.get(k, null);
    }
    match /subs/{userId} {
      allow read: if signedIn();
      allow create, update: if active() && uid() == userId
        && request.resource.data.keys().hasOnly(['lite', 'upgrade', 'pro', 'ultimate', 'ultAdmin', 'lastCode'])
        && !exists(/databases/$(database)/documents/pcodes/$(request.resource.data.lastCode)/used/$(uid()))
        && existsAfter(/databases/$(database)/documents/pcodes/$(request.resource.data.lastCode)/used/$(uid()))
        && planStep(resource == null ? {} : resource.data, request.resource.data, 'lite', get(pcodePath(request.resource.data.lastCode)).data.grants)
        && planStep(resource == null ? {} : resource.data, request.resource.data, 'upgrade', get(pcodePath(request.resource.data.lastCode)).data.grants)
        && planStep(resource == null ? {} : resource.data, request.resource.data, 'pro', get(pcodePath(request.resource.data.lastCode)).data.grants)
        && planStep(resource == null ? {} : resource.data, request.resource.data, 'ultimate', get(pcodePath(request.resource.data.lastCode)).data.grants)
        && planStep(resource == null ? {} : resource.data, request.resource.data, 'ultAdmin', get(pcodePath(request.resource.data.lastCode)).data.grants);
      // the owner can grant or remove plans by hand
      allow write: if isOwner();
    }
    // big pictures (profile and chat): one record plus up to 24 pieces of 900 KB, never edited; you can't list them
    function mediaPartsOk(kind, p) {
      return (kind in ['avatar', 'banner'] && isLite() && p <= maxParts())
        || (kind == 'chat' && isLite() && p <= (isUpgrade() ? 8 : 2));
    }
    match /media/{id} {
      allow get: if signedIn();
      allow create: if active() && id.matches('^[A-Za-z0-9]{16,30}$') && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'data', 'parts', 'at'])
        && request.resource.data.kind in ['avatar', 'banner', 'chat']
        && request.resource.data.data is string && request.resource.data.data.size() < 950000
        && request.resource.data.parts is int && request.resource.data.parts >= 0
        && mediaPartsOk(request.resource.data.kind, request.resource.data.parts)
        && (request.resource.data.data.matches('^data:image/(gif|png|webp|jpeg);base64,.*') || (request.resource.data.data == '' && request.resource.data.parts >= 2));
      allow delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
      match /parts/{n} {
        allow get: if signedIn();
        allow create: if active() && n.matches('^[0-9]{1,2}$') && getAfter(/databases/$(database)/documents/media/$(id)).data.uid == uid()
          && int(n) < getAfter(/databases/$(database)/documents/media/$(id)).data.parts
          && request.resource.data.keys().hasOnly(['d']) && request.resource.data.d is string && request.resource.data.d.size() <= 900000;
        allow delete: if signedIn() && (get(/databases/$(database)/documents/media/$(id)).data.uid == uid() || isAdmin());
      }
    }

    // ---------- Lumen Creators ----------
    function appPath(u) { return /databases/$(database)/documents/creatorApps/$(u); }
    function isCreator() { return isAdmin() || (signedIn() && exists(appPath(uid())) && get(appPath(uid())).data.status == 'approved'); }
    // applications: you apply (pending); only the admin can approve or reject
    match /creatorApps/{userId} {
      allow get: if signedIn() && (uid() == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if active() && uid() == userId && request.resource.data.status == 'pending'
        && request.resource.data.about is string && request.resource.data.about.size() <= 600
        && request.resource.data.get('links', '').size() <= 400;
      // re-apply after a rejection
      allow update: if active() && uid() == userId && resource.data.status == 'rejected' && request.resource.data.status == 'pending'
        && request.resource.data.about is string && request.resource.data.about.size() <= 600;
      allow update, delete: if isAdmin();
    }
    // projects = Marketplace products: creators submit games, websites, ebooks, documents, resources and anything else;
    // the admin reviews, features, hides and deletes. A product is delivered as a link, an uploaded file (up to 3 MB)
    // or an uploaded HTML game; links and files sit in projects/{id}/private, readable once you own it.
    function projectOk(d) {
      return d.type in ['game', 'site', 'ebook', 'doc', 'asset', 'other'] && d.title is string && d.title.size() >= 2 && d.title.size() <= 60
        && d.url is string && d.url.size() <= 500 && (d.url.matches('^https://.*') || (d.type != 'site' && d.url == ''))
        && d.get('deliver', 'link') in ['link', 'file', 'html'] && (d.get('deliver', 'link') != 'html' || d.type == 'game')
        && (d.type != 'site' || d.get('deliver', 'link') == 'link')
        && d.get('fname', '') is string && d.get('fname', '').size() <= 120 && d.get('fmime', '') is string && d.get('fmime', '').size() <= 100
        && d.get('fsize', 0) is int && d.get('fsize', 0) >= 0 && d.get('fsize', 0) <= 3145728
        && d.get('price', 0) is int && d.get('price', 0) >= 0 && d.get('price', 0) <= 5000 && d.get('price', 0) % 10 == 0
        && (d.type != 'site' || d.get('price', 0) == 0)
        && d.get('cut', 0) is int && (d.get('price', 0) == 0 ? d.get('cut', 0) == 0 : d.get('cut', 0) * 10 == d.get('price', 0) * 9)
        && d.get('desc', '').size() <= 1500 && okImage(d.get('image', '')) && d.get('image', '').size() < 900000
        && d.get('ix', 50) is int && d.get('ix', 50) >= 0 && d.get('ix', 50) <= 100
        && d.get('iy', 50) is int && d.get('iy', 50) >= 0 && d.get('iy', 50) <= 100
        && d.get('iz', 100) is int && d.get('iz', 100) >= 100 && d.get('iz', 100) <= 400
        && d.get('ar', 160) is int && d.get('ar', 160) >= 5 && d.get('ar', 160) <= 2000;
    }
    function counters() { return ['minutes', 'mentions', 'upReviews', 'paidMin', 'paidMent', 'paidRev', 'lastMention', 'lastReview', 'sales', 'sold', 'paidSold', 'lastBuyer']; }
    match /projects/{id} {
      function d() { return request.resource.data; }
      function o() { return resource.data; }
      function keys() { return d().diff(o()).affectedKeys(); }
      function live() { return o().status == 'approved' && o().type == 'game'; }
      allow get: if signedIn() && (resource.data.status == 'approved' || resource.data.uid == uid() || isAdmin());
      allow list: if signedIn() && (resource.data.status == 'approved' || resource.data.uid == uid() || isAdmin());
      allow create: if active() && isCreator() && d().uid == uid() && (d().status == 'pending' || (isAdmin() && d().status == 'approved'))
        && d().get('featured', false) == false && projectOk(d()) && !d().keys().hasAny(counters());
      // a creator changes the link, picture or type: back into review (counters can't be touched)
      allow update: if active() && isCreator() && o().uid == uid()
        && keys().hasOnly(['type', 'title', 'url', 'desc', 'image', 'ix', 'iy', 'iz', 'ar', 'price', 'cut', 'status', 'at', 'deliver', 'fname', 'fsize', 'fmime'])
        && d().status == 'pending' && projectOk(d());
      // a creator edits the listing itself (title, description, framing, price): stays live
      allow update: if active() && isCreator() && o().uid == uid()
        && keys().hasOnly(['title', 'desc', 'ix', 'iy', 'iz', 'ar', 'price', 'cut', 'at']) && d().status == o().status && projectOk(d());
      // someone buys (or gets a free) product (paired with the purchase on their account)
      allow update: if active() && o().status == 'approved' && o().type != 'site' && uid() != o().uid
        && keys().hasOnly(['sales', 'sold', 'lastBuyer']) && d().sales == o().get('sales', 0) + 1 && d().sold == o().get('sold', 0) + o().get('cut', 0) && d().lastBuyer == uid()
        && !get(/databases/$(database)/documents/users/$(uid())).data.get('owned', []).hasAny(['p_' + id])
        && getAfter(/databases/$(database)/documents/users/$(uid())).data.get('owned', []).hasAny(['p_' + id]);
      allow update: if isAdmin() && projectOk(d()) && d().status in ['pending', 'approved', 'rejected'];
      allow delete: if (signedIn() && o().uid == uid()) || isAdmin();
      // someone else played for one more minute (paired with their rate-limited playtime record)
      allow update: if active() && live() && uid() != o().uid && keys().hasOnly(['minutes'])
        && d().minutes == o().get('minutes', 0) + 1
        && getAfter(/databases/$(database)/documents/projects/$(id)/time/$(uid() + '_' + today())).data.m
           == (exists(/databases/$(database)/documents/projects/$(id)/time/$(uid() + '_' + today())) ? get(/databases/$(database)/documents/projects/$(id)/time/$(uid() + '_' + today())).data.m : 0) + 1;
      // a new post by someone else mentioned this game (paired with the mention record)
      allow update: if active() && live() && uid() != o().uid && keys().hasOnly(['mentions', 'lastMention'])
        && d().mentions == o().get('mentions', 0) + 1
        && !exists(/databases/$(database)/documents/projects/$(id)/mentions/$(d().lastMention))
        && existsAfter(/databases/$(database)/documents/projects/$(id)/mentions/$(d().lastMention));
      // a new positive review by someone else (paired with the review)
      allow update: if active() && o().status == 'approved' && uid() != o().uid && keys().hasOnly(['upReviews', 'lastReview'])
        && d().upReviews == o().get('upReviews', 0) + 1 && d().lastReview == uid()
        && !exists(/databases/$(database)/documents/projects/$(id)/reviews/$(uid()))
        && getAfter(/databases/$(database)/documents/projects/$(id)/reviews/$(uid())).data.up == true;
      // the creator marks earnings as paid out (the Glow itself is checked in users)
      allow update: if active() && uid() == o().uid && keys().hasOnly(['paidMin', 'paidMent', 'paidRev', 'paidSold'])
        && d().get('paidMin', 0) == o().get('minutes', 0) && d().get('paidMent', 0) == o().get('mentions', 0) && d().get('paidRev', 0) == o().get('upReviews', 0)
        && d().get('paidSold', 0) == o().get('sold', 0);

      // a product's link or uploaded file: only its creator, the admin and people who own it can read it
      match /private/{doc} {
        allow read: if signedIn() && (get(projPath(id)).data.uid == uid() || isAdmin()
          || get(/databases/$(database)/documents/users/$(uid())).data.get('owned', []).hasAny(['p_' + id]));
        allow create, update: if active() && doc == 'link' && getAfter(projPath(id)).data.uid == uid()
          && (getAfter(projPath(id)).data.status == 'pending' || isAdmin())
          && request.resource.data.keys().hasOnly(['url']) && request.resource.data.url is string
          && request.resource.data.url.size() <= 500 && request.resource.data.url.matches('^https://.*');
        // an uploaded file or HTML game: its details here, the data in up to 6 pieces of 900 KB
        allow create, update: if active() && doc == 'file' && getAfter(projPath(id)).data.uid == uid()
          && (getAfter(projPath(id)).data.status == 'pending' || isAdmin())
          && request.resource.data.keys().hasOnly(['name', 'mime', 'bytes', 'parts'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 120
          && request.resource.data.mime is string && request.resource.data.mime.size() <= 100
          && request.resource.data.bytes is int && request.resource.data.bytes > 0 && request.resource.data.bytes <= 3145728
          && request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 6;
        allow delete: if signedIn() && (get(projPath(id)).data.uid == uid() || isAdmin());
        match /parts/{n} {
          allow read: if signedIn() && (get(projPath(id)).data.uid == uid() || isAdmin()
            || get(/databases/$(database)/documents/users/$(uid())).data.get('owned', []).hasAny(['p_' + id]));
          allow create, update: if active() && doc == 'file' && n.matches('^[0-5]$') && getAfter(projPath(id)).data.uid == uid()
            && (getAfter(projPath(id)).data.status == 'pending' || isAdmin())
            && request.resource.data.keys().hasOnly(['d']) && request.resource.data.d is string && request.resource.data.d.size() <= 900000;
          allow delete: if signedIn() && (!exists(projPath(id)) || get(projPath(id)).data.uid == uid() || isAdmin());
        }
      }

      // playtime: one record per player per game per day; +1 minute at most every 50 seconds, up to 4 hours a day
      match /time/{rec} {
        allow get: if signedIn() && rec.matches('^' + uid() + '_.*');
        allow create: if active() && rec == uid() + '_' + today() && get(projPath(id)).data.uid != uid()
          && request.resource.data.m == 1 && request.resource.data.at == request.time
          && getAfter(projPath(id)).data.minutes == get(projPath(id)).data.get('minutes', 0) + 1;
        allow update: if active() && rec == uid() + '_' + today()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['m', 'at'])
          && request.resource.data.m == resource.data.m + 1 && request.resource.data.m <= 240
          && request.resource.data.at == request.time && request.time > resource.data.at + duration.value(50, 's')
          && getAfter(projPath(id)).data.minutes == get(projPath(id)).data.get('minutes', 0) + 1;
      }
      // a post that names the game: one per post, written together with the new post
      match /mentions/{postId} {
        allow read: if signedIn();
        allow create: if active() && !exists(postPath(postId)) && getAfter(postPath(postId)).data.uid == uid()
          && get(projPath(id)).data.uid != uid() && request.resource.data.uid == uid()
          && getAfter(projPath(id)).data.mentions == get(projPath(id)).data.get('mentions', 0) + 1;
      }
      // reviews: one per person, never by the creator; thumbs up or down can't be changed later
      match /reviews/{who} {
        allow read: if signedIn();
        allow create: if active() && who == uid() && get(projPath(id)).data.uid != uid() && get(projPath(id)).data.status == 'approved'
          && reviewOk(request.resource.data)
          && (request.resource.data.up == false
              || getAfter(projPath(id)).data.upReviews == get(projPath(id)).data.get('upReviews', 0) + 1);
        allow update: if active() && who == uid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'at']) && reviewOk(request.resource.data);
        allow delete: if isAdmin();
      }
    }
    function reviewOk(d) { return d.uid == uid() && d.up is bool && d.text is string && d.text.size() <= 500 && d.at == request.time; }
    // reviews of Lumen's built-in games
    match /reviews/{key}/list/{who} {
      allow read: if signedIn();
      allow create: if active() && who == uid() && key.matches('^b_[a-z0-9]+$') && reviewOk(request.resource.data);
      allow update: if active() && who == uid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'at']) && reviewOk(request.resource.data);
      allow delete: if isAdmin();
    }
    // ---------- creator shop items (profile effects, decorations, nameplates made from a transparent GIF) ----------
    function itemOk(d) {
      return d.type in ['fx', 'deco', 'plate', 'sticker'] && d.name is string && d.name.size() >= 2 && d.name.size() <= 30
        && d.get('desc', '') is string && d.get('desc', '').size() <= 120
        && d.price is int && d.price >= 50 && d.price <= 5000 && d.price % 10 == 0 && d.cut is int
        && (d.cut * 10 == d.price * 9 || d.cut * 2 == d.price)
        && d.mode in ['fill', 'tile', 'place'];
    }
    match /shopItems/{id} {
      function d() { return request.resource.data; }
      function o() { return resource.data; }
      function keys() { return d().diff(o()).affectedKeys(); }
      function userPath() { return /databases/$(database)/documents/users/$(uid()); }
      allow get, list: if signedIn() && (resource.data.status == 'approved' || resource.data.uid == uid() || isAdmin());
      allow create: if active() && isCreator() && id.matches('^c_[A-Za-z0-9]{8,24}$') && d().uid == uid() && (d().status == 'pending' || (isAdmin() && d().status == 'approved'))
        && itemOk(d()) && (d().type != 'sticker' || isLite()) && !d().keys().hasAny(['sales', 'earned', 'paidEarned', 'lastBuyer'])
        && existsAfter(/databases/$(database)/documents/shopImgs/$(id));
      // the creator edits it: back into review
      allow update: if active() && isCreator() && o().uid == uid()
        && keys().hasOnly(['type', 'name', 'desc', 'price', 'cut', 'mode', 'status', 'at']) && d().status == 'pending' && itemOk(d()) && (d().type != 'sticker' || isLite());
      // the creator edits the listing (name, description, price): stays live
      allow update: if active() && isCreator() && o().uid == uid()
        && keys().hasOnly(['name', 'desc', 'price', 'cut', 'mode', 'at']) && d().status == o().status && itemOk(d());
      allow update: if isAdmin() && itemOk(d()) && d().status in ['pending', 'approved', 'rejected'];
      // someone buys it (paired with the purchase on their account)
      allow update: if active() && o().status == 'approved' && o().uid != uid() && keys().hasOnly(['sales', 'earned', 'lastBuyer'])
        && d().sales == o().get('sales', 0) + 1 && d().earned == o().get('earned', 0) + o().cut && d().lastBuyer == uid()
        && !get(userPath()).data.get('owned', []).hasAny([id]) && getAfter(userPath()).data.get('owned', []).hasAny([id]);
      // the creator collects their share (the Glow itself is checked in users)
      allow update: if active() && o().uid == uid() && keys().hasOnly(['paidEarned']) && d().paidEarned == o().get('earned', 0);
      allow delete: if (signedIn() && o().uid == uid()) || isAdmin();
    }
    // where and how a creator's image sits: position and size in %, opacity in %
    function placeOk(d) {
      return d.get('x', 50) is int && d.get('x', 50) >= 0 && d.get('x', 50) <= 100
        && d.get('y', 50) is int && d.get('y', 50) >= 0 && d.get('y', 50) <= 100
        && d.get('scale', 100) is int && d.get('scale', 100) >= 10 && d.get('scale', 100) <= 400
        && d.get('op', 100) is int && d.get('op', 100) >= 10 && d.get('op', 100) <= 100;
    }
    match /shopImgs/{id} {
      allow read: if signedIn();
      // a new picture needs review (unless you're the admin); moving the same picture around doesn't
      allow create, update: if active() && request.resource.data.uid == uid()
        && (getAfter(itemPath(id)).data.status == 'pending' || isAdmin() || (resource != null && request.resource.data.data == resource.data.data))
        && request.resource.data.keys().hasOnly(['uid', 'data', 'parts', 'mode', 'type', 'x', 'y', 'scale', 'op'])
        && request.resource.data.data is string && request.resource.data.data.size() < 950000
        && (request.resource.data.data.matches('^data:image/(gif|png|webp|jpeg);base64,.*')
            || (request.resource.data.data == '' && request.resource.data.get('parts', 0) is int && request.resource.data.get('parts', 0) >= 2 && request.resource.data.get('parts', 0) <= maxParts()))
        && placeOk(request.resource.data)
        && getAfter(itemPath(id)).data.uid == uid();
      allow delete: if (signedIn() && resource.data.uid == uid()) || isAdmin();
      // big pictures (up to a 4 MB GIF) are split into up to 8 pieces of 900 KB; a new picture needs review
      match /parts/{n} {
        allow read: if signedIn();
        allow create, update: if active() && n.matches('^[0-9]{1,2}$') && int(n) < maxParts() && getAfter(itemPath(id)).data.uid == uid()
          && (getAfter(itemPath(id)).data.status == 'pending' || isAdmin())
          && request.resource.data.keys().hasOnly(['d']) && request.resource.data.d is string && request.resource.data.d.size() <= 900000;
        allow delete: if signedIn() && (!exists(itemPath(id)) || get(itemPath(id)).data.uid == uid() || isAdmin());
      }
    }

    // play counts for "Most played": +1 per person per game per day, paired with a play record
    function playPath(k) { return /databases/$(database)/documents/plays/$(k); }
    match /plays/{key} {
      allow read: if signedIn();
      allow create: if active() && request.resource.data.count == 1 && request.resource.data.keys().hasOnly(['count', 'd' + today()])
        && request.resource.data.get('d' + today(), 1) == 1
        && existsAfter(/databases/$(database)/documents/plays/$(key)/by/$(uid() + '_' + today()));
      allow update: if active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'd' + today()])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.get('d' + today(), 0) == resource.data.get('d' + today(), 0) + 1
        && !exists(/databases/$(database)/documents/plays/$(key)/by/$(uid() + '_' + today()))
        && existsAfter(/databases/$(database)/documents/plays/$(key)/by/$(uid() + '_' + today()));
      allow delete: if isAdmin();
      match /by/{rec} {
        allow get: if signedIn() && rec.matches('^' + uid() + '_.*');
        allow create: if active() && rec == uid() + '_' + today()
          && getAfter(playPath(key)).data.count == (exists(playPath(key)) ? get(playPath(key)).data.count : 0) + 1;
      }
    }

    match /server/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.data.get('channels', []).size() <= 40 && request.resource.data.get('pinned', []).size() <= 30;
    }

    // Nightbound lobbies you're hosting (so others on Lumen can join); only you write yours
    match /lobbies/{userId} {
      allow read: if signedIn();
      allow create, update: if active() && uid() == userId
        && request.resource.data.keys().hasOnly(['code', 'n', 'max', 'name', 'at'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Z0-9]{3,12}$')
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 16
        && request.resource.data.max is int && request.resource.data.max >= 1 && request.resource.data.max <= 16
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.at == request.time;
      allow delete: if (signedIn() && uid() == userId) || isAdmin();
    }

    // "… is typing": rooms are public; a private chat's typing doc only for its two people.
    // You can only set your own entry, to "now" or to nothing.
    match /typing/{key} {
      function okKey() { return key.matches('^r_.{1,32}$') || (key.matches('^d_[^_]+_[^_]+$') && uid() in key.split('_')); }
      allow read: if signedIn() && okKey();
      allow create: if active() && okKey() && request.resource.data.keys().hasOnly([uid()])
        && (request.resource.data[uid()] == request.time || request.resource.data[uid()] == null);
      allow update: if active() && okKey() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([uid()])
        && (request.resource.data[uid()] == request.time || request.resource.data[uid()] == null);
    }

    // lets people see that the admin messaged them (they aren't friends)
    match /inbox/{userId}/from/{sender} {
      allow read: if signedIn() && uid() == userId;
      allow write: if isAdmin() && sender == uid();
    }

    // Online status + what you're doing: only you and your friends can read it.
    match /presence/{userId} {
      allow read: if signedIn() && (uid() == userId || friends(userId));
      allow write: if active() && uid() == userId;
    }

    // Friend requests. ID is the two user IDs sorted and joined with "_".
    match /friendships/{id} {
      allow read: if signedIn() && uid() in resource.data.users;
      allow create: if active()
        && request.resource.data.from == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && uid() in request.resource.data.users
        && request.resource.data.users[0] < request.resource.data.users[1]
        && id == request.resource.data.users[0] + '_' + request.resource.data.users[1];
      // only the person who received the request can accept it
      allow update: if signedIn() && uid() in resource.data.users && uid() != resource.data.from
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && uid() in resource.data.users;
    }

    // a reply quotes a short piece of the message it answers
    function replyOk(d) { return d.get('reply', null) == null || (d.reply is map && d.reply.keys().hasOnly(['id', 'uid', 'text'])
      && d.reply.id is string && d.reply.id.size() <= 40 && d.reply.uid is string && d.reply.get('text', '') is string && d.reply.get('text', '').size() <= 140); }
    // your own message: fix the text (marked as edited)
    function msgEditOk() { return resource.data.uid == uid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited'])
      && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000 && request.resource.data.edited == request.time; }
    // one reaction per person per message, stored under your own id
    function reactOk() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['react'])
      && request.resource.data.react is map && request.resource.data.react.size() <= 60
      && request.resource.data.react.diff(resource.data.get('react', {})).affectedKeys().hasOnly([uid()])
      && (!(uid() in request.resource.data.react) || (request.resource.data.react[uid()] is string && request.resource.data.react[uid()].size() <= 16)); }
    function chatMediaOk(d) { return d.get('media', '') == '' || (d.media is string && d.media.matches('^[A-Za-z0-9]{16,30}$')
      && get(/databases/$(database)/documents/media/$(d.media)).data.uid == uid() && get(/databases/$(database)/documents/media/$(d.media)).data.kind == 'chat'); }
    // Private chats: only the two friends in the chat.
    match /dms/{pair}/messages/{msg} {
      function members() { return pair.split('_'); }
      function other() { return members()[0] == uid() ? members()[1] : members()[0]; }
      allow read: if signedIn() && uid() in members();
      allow create: if active() && uid() in members() && members().size() == 2
        && (friends(other()) || isAdmin() || other() == adminId())
        && request.resource.data.uid == uid()
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && okImage(request.resource.data.get('gif', '')) && chatMediaOk(request.resource.data) && replyOk(request.resource.data)
        && request.resource.data.at == request.time;
      allow update: if active() && uid() in members() && (msgEditOk() || reactOk());
      allow delete: if signedIn() && uid() in members() && resource.data.uid == uid();
    }

    // Public rooms.
    match /rooms/{room}/messages/{msg} {
      allow read: if signedIn();
      allow create: if active() && room.size() <= 32
        && request.resource.data.uid == uid()
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && okImage(request.resource.data.get('gif', '')) && chatMediaOk(request.resource.data) && replyOk(request.resource.data)
        && request.resource.data.at == request.time;
      allow update: if active() && (msgEditOk() || reactOk());
      allow delete: if (signedIn() && resource.data.uid == uid()) || isAdmin();
    }

    // Posts: likes, views and comments.
    // one record per person, puzzle and day: started now, finished at least 15 seconds later (paired with the Glow)
    match /dailies/{id} {
      allow get: if signedIn() && id.matches('^' + uid() + '_.*');
      allow create: if active() && request.resource.data.g in ['mines', 'memory', 'slide'] && id == uid() + '_' + today() + '_' + request.resource.data.g
        && request.resource.data.keys().hasOnly(['g', 'start', 'done']) && request.resource.data.start == request.time && request.resource.data.done == false;
      allow update: if active() && id.matches('^' + uid() + '_' + today() + '_.*') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
        && resource.data.done == false && request.resource.data.done == true && request.time > resource.data.start + duration.value(15, 's')
        && getAfter(/databases/$(database)/documents/users/$(uid())).data.get('lastDaily', '') == id;
    }
    match /reports/{rid} {
      allow get: if signedIn() && (resource == null || resource.data.by == uid() || isAdmin());
      allow list, update, delete: if isAdmin();
      allow create: if active() && rid == request.resource.data.post + '_' + uid()
        && request.resource.data.keys().hasOnly(['post', 'postUid', 'by', 'reason', 'note', 'status', 'at'])
        && request.resource.data.by == uid() && request.resource.data.status == 'open' && request.resource.data.at == request.time
        && request.resource.data.reason in ['useless', 'spam', 'rude', 'other']
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && get(postPath(request.resource.data.post)).data.uid == request.resource.data.postUid && request.resource.data.postUid != uid();
    }
    // Content: a post can be a plain post, a poll (2-6 options, optional end time), a question, a link or a Store pick
    function optOk(o, i) { return o.size() <= i || (o[i] is string && o[i].size() >= 1 && o[i].size() <= 80); }
    function pollOk(p) {
      return p is map && p.keys().hasOnly(['opts', 'ends']) && p.opts is list && p.opts.size() >= 2 && p.opts.size() <= 6
        && optOk(p.opts, 0) && optOk(p.opts, 1) && optOk(p.opts, 2) && optOk(p.opts, 3) && optOk(p.opts, 4) && optOk(p.opts, 5)
        && (p.get('ends', null) == null || (p.ends is timestamp && p.ends > request.time && p.ends < request.time + duration.value(32, 'd')));
    }
    function contentOk(d) {
      let k = d.get('kind', 'post');
      return k in ['post', 'poll', 'question', 'link', 'share']
        && d.get('votes', {}).size() == 0 && d.get('best', '') == ''
        && (k == 'poll') == ('poll' in d) && (!('poll' in d) || pollOk(d.poll))
        && (k == 'link') == (d.get('link', '') != '') && (d.get('link', '') == '' || (d.link is string && d.link.size() <= 500 && d.link.matches('^https://.*')))
        && (k == 'share') == (d.get('share', '') != '') && (d.get('share', '') == '' || (d.share is string && d.share.matches('^[pb]_[A-Za-z0-9]{1,40}$')));
    }
    match /posts/{post} {
      function d() { return request.resource.data; }
      function o() { return resource.data; }
      function keys() { return d().diff(o()).affectedKeys(); }
      allow read: if signedIn();
      allow create: if active() && d().uid == uid()
        && d().text is string && d().text.size() <= 2000
        && okImage(d().get('image', ''))
        && d().at == request.time
        && d().get('likes', []).size() == 0 && d().get('views', 0) == 0 && d().get('ecomments', 0) == 0
        && d().get('paidViews', 0) == 0 && d().get('paidComments', 0) == 0 && contentOk(d());
      // vote in a poll: add only your own vote, once, while the poll is open
      allow update: if active() && keys().hasOnly(['votes']) && o().get('kind', 'post') == 'poll'
        && d().votes is map && d().votes.diff(o().get('votes', {})).affectedKeys().hasOnly([uid()])
        && !(uid() in o().get('votes', {})) && d().votes[uid()] is int && d().votes[uid()] >= 0 && d().votes[uid()] < o().poll.opts.size()
        && (o().poll.get('ends', null) == null || request.time < o().poll.ends);
      // the person who asked a question picks (or clears) the best answer
      allow update: if active() && uid() == o().uid && o().get('kind', 'post') == 'question' && keys().hasOnly(['best'])
        && d().best is string && d().best.size() <= 40;
      // like or unlike: add or remove only your own id
      allow update: if active() && keys().hasOnly(['likes']) && d().likes.size() <= 5000
        && ((d().likes.toSet().difference(o().get('likes', []).toSet()) == [uid()].toSet() && o().get('likes', []).toSet().difference(d().likes.toSet()).size() == 0)
         || (o().get('likes', []).toSet().difference(d().likes.toSet()) == [uid()].toSet() && d().likes.toSet().difference(o().get('likes', []).toSet()).size() == 0));
      // a view: +1, paired with a new view record (max 2 per account per post per day, never the author)
      allow update: if active() && uid() != o().uid && keys().hasOnly(['views', 'lastView'])
        && d().views == o().get('views', 0) + 1
        && (d().lastView == uid() + '_' + today() + '_1' || d().lastView == uid() + '_' + today() + '_2')
        && !exists(/databases/$(database)/documents/posts/$(post)/views/$(d().lastView))
        && existsAfter(/databases/$(database)/documents/posts/$(post)/views/$(d().lastView));
      // a comment from someone else: +1, paired with the new comment
      allow update: if active() && uid() != o().uid && keys().hasOnly(['ecomments', 'lastComment'])
        && d().ecomments == o().get('ecomments', 0) + 1
        && !exists(/databases/$(database)/documents/posts/$(post)/comments/$(d().lastComment))
        && getAfter(/databases/$(database)/documents/posts/$(post)/comments/$(d().lastComment)).data.uid == uid();
      // the author marks views and comments as paid out (the Glow itself is checked in users)
      allow update: if active() && uid() == o().uid && keys().hasOnly(['paidViews', 'paidComments'])
        && d().paidViews == o().get('views', 0) && d().paidComments == o().get('ecomments', 0)
        && d().paidViews >= o().get('paidViews', 0) && d().paidComments >= o().get('paidComments', 0);
      // the Lumen team accepts a report: the post earns no more Glow, and its author sees why
      allow update: if isAdmin() && keys().hasOnly(['flagged'])
        && (d().get('flagged', null) == null || (d().flagged is map && d().flagged.keys().hasOnly(['reason', 'note', 'at'])
          && d().flagged.reason is string && d().flagged.reason.size() <= 60 && d().flagged.get('note', '') is string && d().flagged.get('note', '').size() <= 300));
      allow delete: if (signedIn() && o().uid == uid()) || isAdmin();

      match /views/{v} {
        allow get: if signedIn() && v.matches('^' + uid() + '_.*');
        allow create: if active() && v.matches('^' + uid() + '_' + today() + '_[12]$')
          && request.resource.data.uid == uid()
          && get(postPath(post)).data.uid != uid()
          && getAfter(postPath(post)).data.views == get(postPath(post)).data.get('views', 0) + 1;
      }

      match /comments/{c} {
        allow read: if signedIn();
        allow create: if active() && request.resource.data.uid == uid()
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && okImage(request.resource.data.get('gif', ''))
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && (resource.data.uid == uid() || get(postPath(post)).data.uid == uid()) || isAdmin();
      }
    }
  }
}
